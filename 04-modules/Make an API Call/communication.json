{
    "url": "https://api.uproc.io/{{parameters.url}}",
    "method": "{{parameters.method}}",
    "qs": {
		"{{...}}": "{{toCollection(parameters.qs, 'key', 'value')}}"
	},
    "headers": {
		"Content-Type": "application/json"
	},
	"body": "{{parameters.body}}",
	"type": "text",
    "response": {
        "output": {
            "headers": "{{headers}}",
            "body": "{{body}}",
			"statusCode": "{{statusCode}}"
        }
    }
}